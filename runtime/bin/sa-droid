#!/usr/bin/env python3
"""Standalone Droid ACP subagent CLI over the Coding Agent ResidentServer daemon."""
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from agent_runtime.cli_wrappers import run_cli


def main() -> int:
    return run_cli("droid", __doc__)


if __name__ == "__main__":
    sys.exit(main())
